{
  "name": "web",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/postbuild-version.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "NODE_OPTIONS='--import tsx/esm' cucumber-js",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint:security": "eslint src"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@cucumber/cucumber": "^11.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-no-unsanitized": "^4.1.0",
    "eslint-plugin-security": "^3.0.0",
    "playwright": "^1.50.0",
    "tsx": "^4.19.0",
    "typescript": "~5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
